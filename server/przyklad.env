# Przykładowe ustawienia usługi renderującej. Skopiuj do pliku .env obok docker-compose.yml i uzupełnij. Nie ma tu żadnych sekretów.
WK_PORT=8080
# Hasło między stroną a usługą. Wymyśl własne długie hasło i wpisz to samo jako RENDER_TOKEN w ustawieniach strony.
WK_TOKEN=
# Adresy stron, które mogą wołać usługę prosto z przeglądarki (po przecinku). Puste, gdy strona korzysta z pośrednika /api/render.
WK_ORIGINS=
# Silnik renderu: puste = EEVEE (szybki z kartą graficzną), CYCLES = wolniejszy, ale przewidywalny na samym procesorze.
WK_ENGINE=
# Limity czasu jednego zadania w sekundach.
WK_LIMIT_RENDER_S=120
WK_LIMIT_CLOTH_S=300
# Po ilu godzinach kasować zapisane wyniki.
WK_TTL_H=168
# Największa liczba zadań czekających w kolejce i największy bok obrazu w pikselach.
WK_MAX_QUEUE=40
WK_MAX_PX=2000

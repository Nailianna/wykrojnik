# Przykładowe ustawienia. Wszystkie są opcjonalne: bez tego pliku usługa działa na wartościach domyślnych. Nie ma tu żadnych sekretów.
# Klucza API Claude'a tu nie ma i być nie może: każdy użytkownik wpisuje własny w przeglądarce.
WK_PORT=8080
# Hasło potrzebne tylko wtedy, gdy stronę serwuje ktoś inny niż ta usługa i sam dokleja je do zapytań. Zwykle puste.
WK_TOKEN=
# Dodatkowe adresy stron, które mogą wołać usługę z przeglądarki (po przecinku). Puste, gdy stronę serwuje ta sama usługa.
WK_ORIGINS=
# Silnik renderu: CYCLES (domyślny w kontenerze, szybki na samym procesorze) albo puste = EEVEE (dla serwera z kartą graficzną).
WK_ENGINE=CYCLES
# Liczba próbek Cycles: więcej = gładszy obraz i dłuższy render.
WK_SAMPLES=48
# Limity czasu jednego zadania w sekundach.
WK_LIMIT_RENDER_S=120
WK_LIMIT_CLOTH_S=300
# Po ilu godzinach kasować zapisane wyniki.
WK_TTL_H=168
# Największa liczba zadań czekających w kolejce i największy bok obrazu w pikselach.
WK_MAX_QUEUE=40
WK_MAX_PX=2000
# Po ilu sekundach bez zadań wyłączyć Blendera (zwalnia pamięć; następny render startuje kilkanaście sekund dłużej).
WK_IDLE_S=900
# Najwięcej zadań jednej przeglądarki naraz i na godzinę.
WK_MAX_ACTIVE=6
WK_MAX_HOUR=240
